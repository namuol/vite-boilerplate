{
  "name": "vite-namuol-boilerplate",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vite-boilerplate.umd.cjs",
  "module": "./dist/vite-boilerplate.js",
  "exports": {
    ".": {
      "import": "./dist/vite-boilerplate.js",
      "require": "./dist/vite-boilerplate.umd.cjs"
    },
    "./style.css": "./dist/vite-boilerplate.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,tsx,json,css,md}": [
      "eslint --fix",
      "rewrap -i",
      "prettier --write --ignore-unknown"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@stkb/rewrap": "^0.1.0",
    "eslint": "^9.9.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^15.9.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "3.3.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vitest": "^3.2.4"
  }
}
